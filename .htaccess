# Blocca l'accesso diretto ai file che non devono mai essere aperti dal browser.
# hash_password.php NON è in questa lista perché a volte serve aprirlo una
# volta dal browser (vedi LEGGIMI.md): ricordati di cancellarlo dopo l'uso.
<FilesMatch "^(config\.php|schema\.sql)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
